/* NG-nfs-handler example mountlist.
 * Edit SERVER, EXPORT, VOLUME, UID and GID, then copy this file to
 * DEVS:DOSDrivers/ (mount at boot) or SYS:Storage/DOSDrivers/ ("Mount NFS0:").
 * The Startup string MUST stay inside double quotes.
 * All options: see Docs/nfs-handler.txt
 */
Handler   = L:nfs-handler
StackSize = 32768
Priority  = 5
GlobVec   = -1
Activate  = 1
Startup   = "SERVER=192.168.1.100 EXPORT=/export/amiga VOLUME=NAS UID=1000 GID=1000"
